<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="sk.upjs.ics.library.ui.AddApplicationController"
      styleClass="dialog-root" spacing="10" prefWidth="500">

    <Label text="%add.title" styleClass="title"/>

    <Label text="%add.name" styleClass="muted"/>
    <TextField fx:id="nameField" promptText="%add.name.prompt"/>

    <Label text="%add.path" styleClass="muted"/>
    <HBox spacing="8">
        <TextField fx:id="pathField" promptText="%add.path.prompt" HBox.hgrow="ALWAYS"/>
        <Button text="%add.browse" styleClass="secondary" onAction="#onBrowseExe"/>
    </HBox>

    <VBox fx:id="protonBox" spacing="10">
        <Label text="%add.protonVersion" styleClass="muted"/>
        <TextField fx:id="protonVersionField" promptText="%add.protonVersion.prompt"/>

        <Label text="%add.winePrefix" styleClass="muted"/>
        <HBox spacing="8">
            <TextField fx:id="winePrefixField" promptText="%add.winePrefix.prompt" HBox.hgrow="ALWAYS"/>
            <Button text="%add.browse" styleClass="secondary" onAction="#onBrowsePrefix"/>
        </HBox>
    </VBox>

    <Label text="%add.launchOptions" styleClass="muted"/>
    <TextField fx:id="launchOptionsField" promptText="%add.launchOptions.prompt"/>

    <Label text="%add.collections" styleClass="muted"/>
    <ListView fx:id="collectionsList" prefHeight="110"/>

    <CheckBox fx:id="privateCheck" text="%add.private"/>

    <Label fx:id="errorLabel" styleClass="error" wrapText="true" visible="false" managed="false"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="%add.cancel" styleClass="secondary" onAction="#onCancel"/>
        <Button text="%add.save" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
